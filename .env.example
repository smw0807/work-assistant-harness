# 로컬 모의 실행에는 환경변수나 토큰이 필요하지 않습니다.
# 실제 Slack·AI·회사 자격증명을 이 예제나 Git·fixture에 넣지 마세요.
# --env는 프로세스 환경만, --env-file <경로>는 명시한 파일만 읽습니다.
# .env 자동 탐색이나 파일에 없는 값의 환경 fallback은 하지 않습니다.
# 실제 설정 파일은 Git 밖에 두고 chmod 600으로 소유자만 읽고 쓰게 합니다.
SLACK_WORKSPACE_ID=W_EXAMPLE
SLACK_TARGET_USER_ID=U_EXAMPLE
SLACK_CHANNEL_IDS=C_EXAMPLE,C_SECOND_EXAMPLE
# 리스트 댓글 멘션을 감지하려면 URL의 /list/ 다음 ID를 사용합니다.
# 최대 10개까지 한 줄에 쉼표로 구분합니다. 리스트만 감시하면 채널 ID는 생략합니다.
# SLACK_LIST_ID=FEXAMPLE,FSECOND
# 정확히 true 또는 false만 허용합니다. 실제 수신을 시작할 때만 true로 바꿉니다.
SLACK_LIVE_READ_ENABLED=false

# 채널 수신용 토큰입니다. 리스트 전용 사용자 토큰을 생략하면 SLACK_WEB_TOKEN으로 리스트도 조회합니다.
# SLACK_APP_TOKEN=<app-level-token-with-connections-write>
# SLACK_WEB_TOKEN=<read-only-web-api-token>
# 리스트 내보내기와 항목 스레드 조회에는 같은 토큰을 사용합니다.
# 내보내기에는 lists:read, 직접 조회에는 대상 대화의 접근 권한과 해당 history scope가 필요합니다.
# SLACK_LIST_USER_TOKEN=<user-oauth-token>

# 멘션과 수집한 스레드를 분석하려면 별도 Codex relay 설정 파일을 지정합니다.
# 설정 파일도 Git 밖의 소유자 전용 0600 파일이며 경로는 절대 경로여야 합니다.
SLACK_ANALYSIS_ENABLED=false
# 새 리스트 멘션의 항목 스레드도 분석하려면 위 설정과 함께 true로 바꿉니다.
SLACK_LIST_ANALYSIS_ENABLED=false
# SLACK_ANALYSIS_CODEX_CONFIG=/absolute/private/path/codex-relay.json

# 단계 4-B-2의 별도 개인 단건 시험에만 사용합니다. 실제 값은 이 파일에 쓰지 않습니다.
# 환경에 없으면 slack-live-plan/approve/send가 TTY 숨김 입력을 받습니다.
# SLACK_SEND_TOKEN=<bot-token-with-chat-write-and-channels-history>
