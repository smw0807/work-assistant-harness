{
  "name": "work-assistant-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": ">=26.12.1 <27", "pnpm": "12.18.0" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
