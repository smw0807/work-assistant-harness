{
  "name": "work-assistant-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "build": "tsc",
    "start": "pnpm harness slack-listen --env-file /Users/songmin-u/.config/work-assistant-harness/slack.env --data-dir /Users/songmin-u/.config/work-assistant-harness/slack-data",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "tsc && node --test dist/tests/*.test.js",
    "test:migration": "tsc && node --test dist/tests/migration-check-*.test.js",
    "test:company": "tsc && node --test dist/tests/company-readonly-*.test.js",
    "harness": "tsc && node -- dist/src/cli/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "ajv": "8.20.0",
    "isomorphic-git": "1.44.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
